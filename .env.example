# Local Supabase: run `npm run db:start`, then copy the values from
# `npx supabase status`. Save this file as .env.local (never commit it).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only admin key: the "Secret" key from `npx supabase status`.
# Never prefix with NEXT_PUBLIC_ and never expose to the browser.
SUPABASE_SECRET_KEY=

# AI auto-categorize (optional). A free Gemini key from
# https://aistudio.google.com/apikey. Never enable billing on that project.
# Server-only: never prefix with NEXT_PUBLIC_. Check it with `npm run ai:smoke`.
GEMINI_API_KEY=
# Optional: another free-tier model. Default: gemini-3.5-flash-lite.
GEMINI_MODEL=
